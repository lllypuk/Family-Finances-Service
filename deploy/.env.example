# Family Budget Service — production env. Скопируйте в .env рядом с docker-compose.yml.
# Секретов нет: аутентификация — bearer-токены в БД.
#
# CI правит здесь ровно одну строку — FFS_IMAGE. Остальное описывает машину и
# переживает выкаты, поэтому .env остаётся на сервере и в репозиторий не едет.

# Образ приложения. Пишется выкатом (release.sh); значение ниже — стартовое,
# для первой раскатки руками.
FFS_IMAGE=registry.gitlab.shatrov.tech/shatrov.tech/family-finances-service:main

# --- раскладка машины ---
# По умолчанию compose поднимает и приложение, и свой Caddy с Let's Encrypt.
# Если 80 и 443 на машине уже заняты чужим терминатором (так на mini-server),
# раскомментируйте строку ниже: свой Caddy уйдёт в профиль, а приложение встанет
# в общую сеть `edge`. Сеть заводится руками: docker network create edge
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxied.yml

# Подсеть сети `edge` (docker network inspect edge --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}').
# Используется только проксируемой раскладкой: из неё приходит X-Forwarded-For,
# и без неё корзина per-IP в лимитере логина считала бы всех одним клиентом.
FFS_EDGE_SUBNET=172.22.0.0/16

# Домен и почта для Let's Encrypt. Нужны только своей раскладке — в
# проксируемой сертификат выпускает общий Caddy.
DOMAIN=ffs.shatrov.tech
ACME_EMAIL=admin@ffs.shatrov.tech

# Пути внутри контейнера (см. volumes в docker-compose.yml)
DATABASE_PATH=/data/budget.db
BACKUP_DIR=/backups
# Сколько файлов бэкапа хранить: и cron-команда `backup`, и POST /api/v1/backups
BACKUP_KEEP=30

LOG_LEVEL=info
ENVIRONMENT=production
