# Family Budget Service - Production Environment Template
# Copy this file to .env and update with your actual values

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Domain Configuration
DOMAIN=budget.example.com

# Database
DATABASE_PATH=/data/budget.db

# Build context — путь к исходникам относительно project directory (D-02: готового
# образа в GHCR нет, каждый deploy/docker-compose.*.yml собирает образ на месте).
#   `..`     — файл запускается из `deploy/` в клоне репозитория (значение по умолчанию)
#   `./src`  — установка через install.sh: compose лежит в /opt/family-budget,
#              а клон — в /opt/family-budget/src
#BUILD_CONTEXT=./src

# Security - CHANGE THESE VALUES!
# Both are REQUIRED: every deploy/docker-compose.*.yml refuses to start when either
# one is empty or unset.
# Generate each with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
CSRF_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# Logging
LOG_LEVEL=info
ENVIRONMENT=production

# Admin Contact (for Let's Encrypt)
ADMIN_EMAIL=admin@example.com
