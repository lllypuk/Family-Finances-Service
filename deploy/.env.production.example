# Family Budget Service - Production Environment Template
# Copy this file to .env and update with your actual values

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Domain Configuration
DOMAIN=budget.example.com

# Database
DATABASE_PATH=/data/budget.db

# Build context — путь к исходникам относительно project directory (D-02: готового
# образа в GHCR нет, каждый deploy/docker-compose.*.yml собирает образ на месте).
#   `..`     — файл запускается из `deploy/` в клоне репозитория (значение по умолчанию)
#   `./src`  — установка через install.sh: compose лежит в /opt/family-budget,
#              а клон — в /opt/family-budget/src
#BUILD_CONTEXT=./src

# Security - FILL THESE IN!
# Both are REQUIRED and intentionally left EMPTY: every deploy/docker-compose.*.yml
# refuses to start when either one is empty or unset, so an unedited copy of this
# file fails loudly instead of shipping a publicly known key.
# Never commit a real value and never reuse the one from any example file.
# Generate each with: openssl rand -base64 32
SESSION_SECRET=
CSRF_SECRET=

# Logging
LOG_LEVEL=info
ENVIRONMENT=production

# Secure flag on the session cookie. Keep it `true` behind a TLS proxy.
# Set it to `false` while the service is still served over plain http:// —
# a browser silently drops a Secure cookie on an insecure origin, which turns
# login into an endless redirect ("CSRF token not found in session").
COOKIE_SECURE=true

# Admin Contact (for Let's Encrypt)
ADMIN_EMAIL=admin@example.com
