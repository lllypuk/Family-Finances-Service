# =============================================================================
# Family Budget Service - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# For production, ensure all secrets are properly configured!

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database Configuration (SQLite)
# -----------------------------------------------------------------------------
# Path to SQLite database file
# For Docker: /data/budget.db (mounted as volume)
# For local dev: ./data/budget.db
DATABASE_PATH=/data/budget.db

# -----------------------------------------------------------------------------
# Session and Security
# -----------------------------------------------------------------------------
# Both are REQUIRED by docker/docker-compose.yml — compose refuses to start
# when either one is empty or unset. They are intentionally left blank here:
# the placeholder values are rejected outright by the application when
# ENVIRONMENT=production (see internal/config.go, Validate).
# Fill each in with the output of:
#   openssl rand -base64 32
SESSION_SECRET=
CSRF_SECRET=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development | production
ENVIRONMENT=production

# `Secure` flag on the session cookie. Defaults to `true` when
# ENVIRONMENT=production, `false` otherwise. Keep it `false` while the service is
# reachable over plain http:// — a browser drops a Secure cookie on an insecure
# origin, and login turns into an endless redirect.
COOKIE_SECURE=false

# Logging Configuration
# Levels: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Docker Compose Configuration
# -----------------------------------------------------------------------------
# Directory for SQLite data (used by docker-compose)
DATA_DIR=./data

# NOTE: compose v2 reads `.env` from the *project directory*, which defaults to the
# directory of the first `-f` file (i.e. `docker/`). Keep this file in the repo root
# and pass `--project-directory .`, exactly as the `make docker-*` targets do:
#   docker compose --project-directory . -f docker/docker-compose.yml up -d
